{
  "multipart": [
    {
      "when": { "axis": "y", "pollinated": "false" },
      "apply": { "model": "symbioticsurvival:block/milkweed_0" }
    },
    {
      "when": { "axis": "y", "pollinated": "true" },
      "apply": { "model": "symbioticsurvival:block/milkweed_1" }
    },
    {
      "when": { "axis": "x", "pollinated": "false" },
      "apply": { "model": "symbioticsurvival:block/milkweed_0", "x": 90, "y": 90 }
    },
    {
      "when": { "axis": "x", "pollinated": "true" },
      "apply": { "model": "symbioticsurvival:block/milkweed_1", "x": 90, "y": 90 }
    },
    {
      "when": { "axis": "z", "pollinated": "false" },
      "apply": { "model": "symbioticsurvival:block/milkweed_0", "x": 90 }
    },
    {
      "when": { "axis": "z", "pollinated": "true" },
      "apply": { "model": "symbioticsurvival:block/milkweed_1", "x": 90 }
    }
  ]
}
