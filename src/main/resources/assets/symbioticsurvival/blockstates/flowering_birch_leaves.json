{
  "multipart": [
    {
      "apply": { "model": "symbioticsurvival:block/flowering_birch_leaves" }
    },
    {
      "when": { "fruit_state": "1" },
      "apply": { "model": "symbioticsurvival:block/flowering_birch_leaves_growing_overlay" }
    },
    {
      "when": { "fruit_state": "2" },
      "apply": { "model": "symbioticsurvival:block/flowering_birch_leaves_ripe_overlay" }
    }
  ]
}
