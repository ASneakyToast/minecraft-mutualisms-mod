{
  "multipart": [
    {
      "apply": { "model": "symbioticsurvival:block/arctic_willow_leaves" }
    },
    {
      "when": { "fruit_state": "1" },
      "apply": { "model": "symbioticsurvival:block/arctic_willow_leaves_growing_overlay" }
    },
    {
      "when": { "fruit_state": "2" },
      "apply": { "model": "symbioticsurvival:block/arctic_willow_leaves_ripe_overlay" }
    }
  ]
}
