{
  "multipart": [
    {
      "apply": {
        "model": "symbioticsurvival:block/enhanced_cherry_leaves"
      }
    },
    {
      "apply": {
        "model": "symbioticsurvival:block/enhanced_cherry_leaves_growing_overlay"
      },
      "when": {
        "fruit_state": "1"
      }
    },
    {
      "apply": {
        "model": "symbioticsurvival:block/enhanced_cherry_leaves_ripe_overlay"
      },
      "when": {
        "fruit_state": "2"
      }
    }
  ]
}